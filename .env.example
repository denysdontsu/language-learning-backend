# Application Mode
VERSION=0.1.0
ENVIRONMENT=development
DEBUG=True

# Server
PORT=8000

# Database PostgreSQL
POSTGRES_USER=language_user
POSTGRES_PASSWORD=password
POSTGRES_HOST=db # Use 'db' for Docker Compose / 'localhost' for local running
POSTGRES_PORT=5432
POSTGRES_DB=language_app

# Redis
REDIS_HOST=redis # Use 'redis' for Docker Compose / 'localhost' for local running
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_ENABLED=True

# API Configuration
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Security (generate with: openssl rand -hex 32)
SECRET_KEY=your-secret-key-min-32-chars

# Logging
LOG_LEVEL=DEBUG